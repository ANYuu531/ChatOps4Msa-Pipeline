digraph G {
 graph [splines=true, outputorder=edgesfirst];
 node [fontname="PingFang TC", fontsize=10, color="#777777", margin="0.08,0.04"];
 edge [color="#555555", arrowsize=0.6, fontname="PingFang TC", fontsize=9, fontcolor="#555555"];
 start [shape=ellipse, style=filled, fillcolor=white, label="合併時遇到\n的一個名稱", pos="0,0!"];
 d1 [shape=diamond, style=filled, fillcolor=white, margin="0.02,0.01", label="規則能\n對齊？", pos="138,0!"];
 m [shape=ellipse, style=filled, fillcolor=white, label="合併", pos="138,-74!"];
 d2 [shape=diamond, style=filled, fillcolor=white, margin="0.02,0.01", label="這個 repo\n存過答案？", pos="276,0!"];
 d3 [shape=diamond, style=filled, fillcolor=white, margin="0.02,0.01", label="答案指向的節點\n這次還在？", pos="276,-74!"];
 skip [shape=box, style="rounded,dashed", fillcolor=white, label="略過這個名稱，\n不建立新節點", pos="430.56,-74!"];
 s1 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="1. 記成問題，\n不默默丟掉", pos="414,0!"];
 s2 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="2. 附排序過的候選，\n與「新節點」「忽略」", pos="552,0!"];
 s3 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="3. 在審查頁面或對話\n裡一次問完", pos="552,-74!"];
 s4 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="4. 以確定性的\n規則解析答案", pos="552,-148!"];
 d4 [shape=diamond, style=filled, fillcolor=white, margin="0.02,0.01", label="看得懂且指向\n存在的節點？", pos="414,-148!"];
 keep [shape=box, style="rounded,dashed", fillcolor=white, label="保留問題，不猜", pos="414,-222!"];
 s5 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="5. 套用，並以 repo\n為單位存下答案", pos="276,-148!"];
 s6 [shape=box, style="rounded,filled", fillcolor="#f4f4f4", label="6. 報告標出這條邊\n靠人的回答", pos="138,-148!"];
 start->d1;
 d1->m [label="能"];
 d1->d2 [label="不能"];
 d2->d3 [label="有"];
 d3->m [label="在"];
 d3->skip [label="不在"];
 d2->s1 [label="沒有"];
 s1->s2;
 s2->s3;
 s3->s4;
 s4->d4;
 d4->keep [label="否"];
 d4->s5 [label="是"];
 s5->s6;
 s6->m;
}
