        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b6770;endArrow=block;" edge="1" parent="1" source="code" target="traffic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b6770;endArrow=block;" edge="1" parent="1" source="k8s" target="traffic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#5b6770;endArrow=block;" edge="1" parent="1" source="traffic" target="measure">
          <mxGeometry relative="1" as="geometry" />
