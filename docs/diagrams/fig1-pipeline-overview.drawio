        <mxCell id="e19" value="持久化" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9aa6b2;endArrow=block;dashed=1;fontSize=10;fontColor=#5b6770;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.35;entryDx=0;entryDy=0;" edge="1" parent="1" source="ckpt" target="store">
